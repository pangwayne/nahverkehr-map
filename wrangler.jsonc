{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nahverkehr-map",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Own subdomain, main site untouched. A Custom Domain is also what makes the Cache API work.
  "routes": [{ "pattern": "nahverkehr.pangwayne.com", "custom_domain": true }],
  // No *.workers.dev or preview copies: the cache does not work there.
  "workers_dev": false,
  "preview_urls": false,
  // The pages (/, /privacy, ...) and /api/* go through the Worker: it adds the security headers, with a
  // fresh nonce per page for Cloudflare's injected bot-check script. The built JS/CSS under /assets/ are
  // served directly and for free. Unknown addresses get 404.html, with status 404.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Requests per visitor (IP) and minute that need Transitous (cache misses only). See src/worker/index.ts.
  // Route searches have their own, lower limit.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
    { "name": "PLAN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
