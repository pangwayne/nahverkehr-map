{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nahverkehr-map",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Own subdomain, main site untouched. A Custom Domain is also what makes the Cache API work.
  "routes": [{ "pattern": "nahverkehr.pangwayne.com", "custom_domain": true }],
  // No *.workers.dev or preview copies: the cache does not work there.
  "workers_dev": false,
  "preview_urls": false,
  // The pages (/, /privacy, ...) and /api/* go through the Worker: it adds the security headers, with a
  // fresh nonce per page for Cloudflare's injected bot-check script. The built JS/CSS under /assets/ are
  // served directly and for free. Unknown addresses get a plain 404.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": { "enabled": true }
}
